{
  "name": "flotiq-ui-plugin-data-model-diagram",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Interactive diagram of your Content Type Definitions, their fields and relations — with search, hiding, auto layout, saved layouts, object counts and PNG/SVG/print export. Shown on the dashboard.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.js",
    "start": "node esbuild.config.js --watch",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,html,mdx,json,yaml,yml,md}\"",
    "lint": "eslint --ext .js,.jsx plugins common"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.9",
    "esbuild": "^0.28.2",
    "esbuild-plugin-eslint": "^0.3.12",
    "esbuild-plugin-inline-import": "^1.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "postcss": "^8.5.33",
    "postcss-url": "^10.1.4"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "chalk": "^5.6.2",
    "elkjs": "0.12.0",
    "html-to-image": "1.11.13",
    "prettier": "^3.9.10",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trzcina/flotiq-ui-plugin-data-model-diagram.git"
  },
  "homepage": "https://github.com/trzcina/flotiq-ui-plugin-data-model-diagram#readme",
  "private": true
}
